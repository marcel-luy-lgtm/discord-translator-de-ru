# --- Pflicht ---
# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# API-Key von https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional ---
# Wenn gesetzt, werden die Slash-Befehle nur auf diesem Server registriert (sofort sichtbar).
# Leer lassen = global (kann bis zu 1 Stunde dauern, bis sie erscheinen).
DEV_GUILD_ID=

# Modelle (Standardwerte sind günstig und schnell)
TRANSLATE_MODEL=gpt-4o-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
# Stimmen: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
TTS_VOICE=alloy

# --- Kostensperre (geschätzte OpenAI-Kosten in USD, 0 = kein Limit) ---
# Ist ein Budget erreicht, übersetzt der Bot nichts mehr bis zum nächsten Tag/Monat.
# Im laufenden Betrieb änderbar mit /kosten limit (überschreibt diese Werte).
DAILY_BUDGET_USD=2
MONTHLY_BUDGET_USD=20
# Optional: nur diese Discord-User-IDs dürfen /kosten limit nutzen (kommagetrennt)
BOT_ADMIN_IDS=

# Zusätzliche Bremse nur für Voice: max. Minuten Sprache, die pro Tag transkribiert werden (0 = unbegrenzt)
VOICE_DAILY_MINUTE_LIMIT=180
